ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

### Browser extension (Firefox signing via Mozilla AMO)
WEB_EXT_API_KEY=
WEB_EXT_API_SECRET=

### Browser automation (Playwright profiles for store import)
# APP_PUBLIC_BASE_URL=http://localhost:5173
# BROWSER_MAX_CONCURRENT=2
# BROWSER_PROFILES_DIR=data/browser_profiles
# Headless=true triggers Walmart/Amazon bot checks; leave false (Docker uses headed Firefox + Xvfb).
# BROWSER_HEADLESS=false
# Leave empty so Firefox reports its own UA.
# BROWSER_USER_AGENT=

### TRACKING (package-tracking API)
UPS_CLIENT=your_ups_client_id
UPS_SECRET=your_ups_secret
# Optional: default is production. Sandbox: https://wwwcie.ups.com/security/v1/oauth/token
# UPS_OAUTH_URL=https://onlinetools.ups.com/security/v1/oauth/token